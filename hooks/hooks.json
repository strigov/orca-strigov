{
  "description": "Claude Code coordinator guards. Codex selects hooks/codex.json through the portable manifest.",
  "hooks": {
    "SessionStart": [{"matcher": "startup|resume|clear|compact", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.cjs"], "timeout": 30}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.cjs"], "timeout": 30}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.cjs"], "timeout": 30}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.cjs"], "timeout": 30}]}]
  }
}
