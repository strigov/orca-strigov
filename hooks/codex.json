{
  "description": "Codex coordinator role and continuation guards. No worker lifecycle mutations.",
  "hooks": {
    "SessionStart": [{"matcher": "startup|resume|clear|compact", "hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/bin/coordinator-session\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/bin/coordinator-session.ps1\" hook", "timeout": 30}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/bin/coordinator-session\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/bin/coordinator-session.ps1\" hook", "timeout": 30}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/bin/coordinator-session\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/bin/coordinator-session.ps1\" hook", "timeout": 30}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/bin/coordinator-session\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/bin/coordinator-session.ps1\" hook", "timeout": 30}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "bash \"${PLUGIN_ROOT}/bin/coordinator-session\" hook", "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/bin/coordinator-session.ps1\" hook", "timeout": 3}]}]
  }
}
