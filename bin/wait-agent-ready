#!/usr/bin/env bash
# wait-agent-ready — block until an agent CLI's TUI is actually on screen in an
# Orca terminal, then wait for tui-idle once more.
#
#   wait-agent-ready <terminal-handle> <agent> [timeout-seconds]
#     agent: agy | codex | claude | <literal screen marker>
#
# Why: `orca terminal wait --for tui-idle` is satisfied by the launching shell's
# prompt within ~1 s, before a slow-starting agent (Antigravity: 10-20 s of
# login/experiment refresh) has drawn anything. A `dispatch --inject` sent in
# that window is lost, and Orca marks the dispatch `agent_prompt_stalled` after
# ~30 s (observed 2026-09-01, phase 2 smoke). Exit 0 = marker seen and idle;
# exit 1 = timeout (print the last screen lines to stderr); exit 2 = usage.
set -euo pipefail
[ $# -ge 2 ] || { echo "usage: wait-agent-ready <handle> <agy|codex|claude|marker> [timeout-s]" >&2; exit 2; }
h="$1"; busy=""; case "$2" in
  agy) marker="Antigravity" ;;      # banner "Antigravity CLI <ver>"
  codex) marker="Ask Codex"         # persistent composer line "Ask Codex to do anything"
         busy="Starting MCP servers" ;;   # composer is drawn before MCP startup ends; Enter sent meanwhile is swallowed (observed 2026-09-01, smoke 3: 50 min idle)
  claude) marker="Claude Code" ;;
  *) marker="$2" ;;
esac
timeout="${3:-120}"
deadline=$(( $(date +%s) + timeout ))
screen() {
  orca terminal read --terminal "$h" --limit 80 --json 2>/dev/null \
    | python3 -c 'import sys,json;d=json.load(sys.stdin);t=d.get("result",{}).get("terminal",{});print("\n".join(x for x in t.get("tail",[]) if isinstance(x,str)))' 2>/dev/null || true
}
while :; do
  scr="$(screen)"
  if grep -qF -- "$marker" <<<"$scr" && { [ -z "$busy" ] || ! tail -20 <<<"$scr" | grep -qF -- "$busy"; }; then
    orca terminal wait --terminal "$h" --for tui-idle --timeout-ms 60000 --json >/dev/null 2>&1 || true
    echo "ready: $marker on $h"
    exit 0
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "timeout: '$marker' not on screen of $h after ${timeout}s; last lines:" >&2
    screen | tail -5 >&2
    exit 1
  fi
  sleep 2
done
