#!/usr/bin/env bash
# Resolve and ensure the working-tree directory the orchestrator uses for
# short-lived artifacts: phase briefs, implementer reports, and review
# packages. Print the directory's absolute physical path.
#
# With PLAN_FILE, resolve one directory per plan
# (.superpowers/sdd/<plan-basename>/) so plans in the same working tree keep
# their artifacts apart. Plans are keyed by BASENAME only: two plan files with
# the same basename in different directories would share one workspace —
# unlikely under the docs/plans/<slug>.md convention, but not prevented.
# Without PLAN_FILE, resolve the shared root (.superpowers/sdd).
#
# The workspace lives in the working tree (not under .git/) because Claude Code
# treats .git/ as a protected path and denies agent writes there — which blocks
# an implementer subagent from writing its report file. A self-ignoring
# .gitignore at .superpowers/sdd/ keeps every plan's workspace out of
# `git status` and out of accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so phase briefs and
# review-package cannot drift to different directories.
#
# Usage: sdd-workspace [PLAN_FILE | --name SLUG]
#   --name SLUG resolves a plan-less workspace (.superpowers/sdd/<SLUG>/) for
#   quickfix runs, which have no plan file.
set -euo pipefail

usage(){ echo "usage: sdd-workspace [PLAN_FILE | --name SLUG]" >&2; exit 2; }
[ $# -le 2 ] || usage

root=$(git rev-parse --show-toplevel)
base="$root/.superpowers/sdd"
dir="$base"

if [ $# -eq 2 ]; then
  [ "$1" = "--name" ] || usage
  slug=$2
  case "$slug" in ""|.|..|*/*) echo "bad workspace name: $slug" >&2; exit 2;; esac
  dir="$base/$slug"
elif [ $# -eq 1 ]; then
  plan=$1
  [ "$plan" != "--name" ] || usage
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  slug=$(basename "$plan" .md)
  [ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
    || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }
  dir="$base/$slug"
  # The plan's ledger is transient coordinator state (never committed). Ignore it
  # locally so C4 snapshots and C5 packages never capture it as candidate source.
  root_phys=$(cd "$root" && pwd -P)
  plan_dir=$(cd "$(dirname "$plan")" && pwd -P)
  case "$plan_dir/" in
    "$root_phys"/*)
      pattern=$(printf '%s/%s.ledger.json' "${plan_dir#"$root_phys"}" "$slug" | sed 's/[][*?\\!#]/\\&/g')
      exclude=$(git rev-parse --git-path info/exclude)
      mkdir -p "$(dirname "$exclude")"
      if ! { [ -f "$exclude" ] && grep -qxF -- "$pattern" "$exclude"; }; then
        if [ -s "$exclude" ] && [ -n "$(tail -c 1 "$exclude")" ]; then printf '\n' >> "$exclude"; fi
        printf '%s\n' "$pattern" >> "$exclude"
      fi ;;
    *) echo "sdd-workspace: plan outside the repository; its ledger is not ignored: $plan" >&2 ;;
  esac
fi

mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd -P
